{
  "name": "pitwall",
  "version": "0.1.0",
  "private": false,
  "description": "A shared room for people and the coding agents on their machines.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.15.0",
  "bin": {
    "pitwall": "./dist/cli/main.js"
  },
  "scripts": {
    "dev": "tsx src/cli/main.ts relay start",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli/main.js relay start",
    "guard": "python3 scripts/guard.py"
  },
  "dependencies": {
    "web-push": "^3.6.7",
    "ws": "^8.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/outfit": "^5.2.8",
    "@types/node": "^24.9.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.10",
    "vitest": "^3.2.4"
  }
}
